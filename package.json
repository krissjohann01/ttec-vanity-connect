{
  "name": "vanity-aws-connect",
  "version": "1.0.0",
  "private": true,
  "description": "Amazon Connect vanity-number lookup: caller number -> vanity numbers via Lambda, spoken back in a contact flow, logged to DynamoDB.",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "jest",
    "lint": "eslint . --ext .ts",
    "synth": "cdk synth",
    "diff": "cdk diff",
    "deploy": "cdk deploy",
    "destroy": "cdk destroy",
    "dev": "ts-node scripts/local-server.ts",
    "db:admin": "DYNAMO_ENDPOINT=http://localhost:8000 AWS_REGION=us-east-1 AWS_ACCESS_KEY_ID=local AWS_SECRET_ACCESS_KEY=local dynamodb-admin"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "aws-cdk": "^2.150.0",
    "dynalite": "^4.0.0",
    "dynamodb-admin": "^5.1.3",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  },
  "dependencies": {
    "@aws-sdk/client-connect": "^3.600.0",
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0",
    "aws-cdk-lib": "^2.150.0",
    "constructs": "^10.3.0"
  },
  "allowScripts": {
    "classic-level@3.0.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "es5-ext@0.10.64": true
  }
}
