{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "moduleResolution": "node",
    "declaration": false,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "dist"
  },
  "include": ["infra/**/*.ts", "lambda/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "dist", "cdk.out"],
  "ts-node": {
    // Without this, ts-node only type-checks files reachable via the entry
    // file's import graph and misses standalone ambient .d.ts shims like
    // scripts/dynalite.d.ts.
    "files": true
  }
}
